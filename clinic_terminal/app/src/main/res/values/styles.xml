<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Use Theme.AppCompat (not MaterialComponents) to avoid
        crashes on phones missing the Material library at runtime.
        NoActionBar removes the default title bar — we draw our own header.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#1565C0</item>
        <item name="colorPrimaryDark">#0D47A1</item>
        <item name="colorAccent">#42A5F5</item>
        <item name="android:windowBackground">#F5F5F5</item>
        <item name="android:statusBarColor">#1565C0</item>
    </style>
</resources>
