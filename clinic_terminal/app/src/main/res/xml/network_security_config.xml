<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 9+ blocks cleartext HTTP by default.
    This config allows HTTP only for local network IPs (192.168.x.x, 10.x.x.x)
    so the clinic terminal can reach the backend over Wi-Fi.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
        <domain includeSubdomains="true">10.0.0.0</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
    <!-- Allow ALL local/private IPs — simplest for development -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
